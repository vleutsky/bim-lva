+        /** Бровка скругления: наружная точка шаблона (max-off от кромки). */
+        function nodeRunBrowPts(data, run) {
+            const pts = run?.pts;
+            if (!pts || pts.length < 2) return null;
+            const profile = data?.outer;
+            let off = 0, dz = 0;
+            if (profile?.pts?.length) {
+                let best = profile.pts[0];
+                for (const q of profile.pts) {
+                    if ((Number(q.off) || 0) > (Number(best.off) || 0) + 1e-9) best = q;
+                }
+                off = Number(best.off) || 0;
+                dz = Number(best.dz) || 0;
+            }
+            return pts.map((p, i) => {
+                const n = outwardNormalAt(pts, i);
+                return { x: p.x + n.x * off, y: p.y + n.y * off, z: p.z + dz };
+            });
+        }
